{
  "name": "zuo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "npm run dev --prefix backend",
    "dev:all": "concurrently -n api,web -c blue,green \"npm run dev:backend\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "install:all": "npm install && npm install --prefix backend"
  },
  "dependencies": {
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "concurrently": "^9.1.2",
    "vite": "^8.0.12"
  }
}
